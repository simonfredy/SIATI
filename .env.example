# Database Connection (MariaDB 10.11+ / MySQL di Laragon)
DATABASE_URL="mysql://root:@localhost:3306/siati_db"

# JWT Authentication Secret (Gunakan random string minimal 32 karakter untuk produksi)
JWT_SECRET="siati_hospital_ticketing_super_secure_jwt_secret_2026_xyz"
JWT_EXPIRES_IN="1d"

# CAPTCHA Configuration
# Mode: "offline" (Self-Hosted Math SVG) atau "turnstile" (Cloudflare Turnstile)
CAPTCHA_MODE="offline"
CAPTCHA_SECRET_KEY="siati_hmac_captcha_secret_key_change_in_production"
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Nginx X-Accel Protected Media Storage
MEDIA_UPLOAD_DIR="C:/laragon/www/SIATI/uploads"
MAX_FILE_SIZE_MB=60

# WhatsApp Gateway (Self-Hosted Baileys URL)
WHATSAPP_GATEWAY_URL="http://127.0.0.1:4000"
WHATSAPP_API_KEY="siati_wa_secret_key"

# Telegram Bot
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ALERT_CHAT_ID=""

# App Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
